# Medhanialem Mahber - Environment Variables Configuration
# Replace these with your Supabase project credentials

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Security Notice:
# Never commit your SUPABASE_SERVICE_ROLE_KEY to client-side code!
# The client should strictly use VITE_SUPABASE_ANON_KEY and rely on Row Level Security (RLS).
